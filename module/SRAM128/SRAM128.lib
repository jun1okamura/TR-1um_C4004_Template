            "10.39460, 10.43740, 10.55270, 10.71710, 10.99080, 11.43240, 12.16960");
        }
        fall_transition (mem_template_7x7) {
          values(\
            "0.55095, 0.58213, 0.66483, 0.78215, 0.98647, 1.36434, 2.12449",\
            "0.55108, 0.58202, 0.66476, 0.78202, 0.98641, 1.36436, 2.12452",\
